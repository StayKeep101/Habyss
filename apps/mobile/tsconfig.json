{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@habyss/core/*": [
        "../../packages/core/src/*"
      ],
      "@habyss/design/*": [
        "../../packages/design/src/*"
      ]
    },
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "supabase/**/*",
    "cloudflare/**/*",
    "lib/_premium/**/*",
    "node_modules"
  ]
}
