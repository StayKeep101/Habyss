{
  "name": "@habyss/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:stress": "TZ=America/Toronto jest lib/__tests__/longevity.stress.test.ts lib/__tests__/databaseStartup.test.ts --runInBand --watch=false",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "type-check": "tsc --noEmit",
    "validate": "npm run check:ui && npm run type-check && npm run test:ci",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "check:ui": "node scripts/check-ui-consistency.cjs && node scripts/sync-shard-icon.cjs --check",
    "check:supabase": "node ../../scripts/check-supabase.mjs",
    "check:auth": "node ../../scripts/check-auth.mjs",
    "apply:migration": "node ../../scripts/apply-migration.mjs",
    "echo:sample": "jest --testMatch '**/scripts/echo-sample.blind.ts' --silent=false --coverage=false",
    "shard:sync": "node scripts/sync-shard-icon.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-ai/apple": "^0.12.0",
    "@react-native-ai/llama": "0.12.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.89.0",
    "ai": "^6.0.86",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-calendar": "~57.0.6",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.22",
    "expo-maps": "~57.0.4",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-speech-recognition": "^58.0.0",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "llama.rn": "0.12.9",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.25.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-health": "^1.19.0",
    "react-native-purchases": "^9.9.0",
    "react-native-purchases-ui": "^9.9.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ],
        "listUnknownPackages": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    },
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-modules-core",
          "expo-camera"
        ]
      }
    }
  },
  "private": true,
  "overrides": {
    "@react-native-ai/llama": {
      "llama.rn": "$llama.rn"
    },
    "react-native-health": {
      "@expo/config-plugins": "~57.0.9"
    }
  },
  "allowScripts": {
    "llama.rn@0.12.9": true,
    "@shopify/react-native-skia@2.6.2": true,
    "@sentry/cli@2.58.4": true
  }
}
