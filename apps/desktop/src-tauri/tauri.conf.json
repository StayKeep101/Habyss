{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Habyss",
  "version": "0.1.0",
  "identifier": "com.habyss.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh ../../scripts/build-widgets.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Habyss",
        "width": 1180,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 760,
        "visible": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ]
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "panel",
        "title": "Habyss",
        "url": "index.html?panel=1",
        "width": 780,
        "height": 720,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "files": {
        "PlugIns/HabyssWidgets.appex": "../../../.build/widgets/Build/Products/Release/HabyssWidgets.appex"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
